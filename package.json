{
  "name": "lemma",
  "description": "Structure-first LaTeX assistant for Overleaf. Runs entirely in your browser.",
  "version": "0.0.0",
  "license": "MIT",
  "author": "Amogh D. Prasanna",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amoghdprasanna/Lemma.git"
  },
  "homepage": "https://github.com/amoghdprasanna/Lemma#readme",
  "bugs": {
    "url": "https://github.com/amoghdprasanna/Lemma/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "icons": "node scripts/generate-icons.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@fontsource-variable/lexend": "5.3.0",
    "@unified-latex/unified-latex-types": "1.8.4",
    "@unified-latex/unified-latex-util-arguments": "1.8.4",
    "@unified-latex/unified-latex-util-parse": "1.8.4",
    "@unified-latex/unified-latex-util-to-string": "1.8.4",
    "@unified-latex/unified-latex-util-visit": "1.8.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.4",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wxt": "0.21.4"
  }
}
